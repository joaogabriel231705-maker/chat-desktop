<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.example.chatdesktop.Controller.ChatController"
        stylesheets="@css/style.css"
        styleClass="root">

    <!-- ========================= -->
    <!-- CABEÇALHO -->
    <!-- ========================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="15"
                styleClass="header">

            <padding>
                <Insets
                        top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <children>

                <VBox
                        spacing="2">

                    <children>

                        <Label
                                text="NEXA AI"
                                styleClass="title"/>

                        <Label
                                text="Inteligência artificial"
                                styleClass="subtitle"/>

                    </children>

                </VBox>

                <HBox
                        HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="limparButton"
                        text="🗑 Limpar"
                        onAction="#limparConversa"
                        styleClass="clear-button"/>

            </children>

        </HBox>

    </top>


    <!-- ========================= -->
    <!-- ÁREA DA CONVERSA -->
    <!-- ========================= -->

    <center>

        <VBox
                spacing="10"
                styleClass="chat-container">

            <padding>
                <Insets
                        top="20"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <children>

                <TextArea
                        fx:id="conversaArea"
                        editable="false"
                        wrapText="true"
                        VBox.vgrow="ALWAYS"
                        promptText="Sua conversa com a Nexa AI aparecerá aqui..."
                        styleClass="conversation-area"/>

                <HBox
                        alignment="CENTER_RIGHT">

                    <children>

                        <Button
                                text="📋 Copiar resposta"
                                onAction="#copiarResposta"
                                styleClass="copy-button"/>

                    </children>

                </HBox>

            </children>

        </VBox>

    </center>


    <!-- ========================= -->
    <!-- ÁREA DE DIGITAÇÃO -->
    <!-- ========================= -->

    <bottom>

        <HBox
                spacing="10"
                alignment="CENTER"
                styleClass="input-container">

            <padding>
                <Insets
                        top="15"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <children>

                <TextField
                        fx:id="mensagemField"
                        promptText="Digite sua mensagem..."
                        HBox.hgrow="ALWAYS"
                        styleClass="message-field"/>

                <Button
                        fx:id="enviarButton"
                        text="Enviar  ➤"
                        onAction="#enviarMensagem"
                        styleClass="send-button"/>

            </children>

        </HBox>

    </bottom>

</BorderPane>