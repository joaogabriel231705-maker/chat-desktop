<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.example.chatdesktop.Controller.ChatController"
        styleClass="root">

    <!-- ====================================================== -->
    <!-- SIDEBAR -->
    <!-- ====================================================== -->

    <left>

        <VBox
                prefWidth="230"
                spacing="18"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="25"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>

            <children>

                <!-- ================================================== -->
                <!-- LOGO -->
                <!-- ================================================== -->

                <VBox spacing="2">

                    <Label
                            text="NEXASOFT"
                            styleClass="chat-title"/>

                    <Label
                            text="NEXA AI"
                            styleClass="online-text"/>

                </VBox>


                <!-- ================================================== -->
                <!-- NOVA CONVERSA -->
                <!-- ================================================== -->

                <Button
                        text="＋  Nova conversa"
                        onAction="#novaConversa"
                        maxWidth="Infinity"
                        styleClass="new-chat-button"
                        mnemonicParsing="false"/>


                <!-- ================================================== -->
                <!-- TÍTULO DA SEÇÃO -->
                <!-- ================================================== -->

                <Label
                        text="CONVERSAS"
                        styleClass="section-title"/>


                <!-- ================================================== -->
                <!-- HISTÓRICO DE CONVERSAS -->
                <!-- ================================================== -->

                <ScrollPane
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="history-scroll">

                    <content>

                        <VBox
                                fx:id="historicoContainer"
                                spacing="6"
                                fillWidth="true"
                                styleClass="history-container"/>

                    </content>

                </ScrollPane>


                <!-- ================================================== -->
                <!-- LIMPAR CONVERSA -->
                <!-- ================================================== -->

                <Button
                        text="🗑  Limpar conversa"
                        onAction="#limparConversa"
                        maxWidth="Infinity"
                        styleClass="sidebar-button"
                        mnemonicParsing="false"/>


                <!-- ================================================== -->
                <!-- RODAPÉ -->
                <!-- ================================================== -->

                <Label
                        text="NexaSoft • AI"
                        styleClass="sidebar-footer"/>

            </children>

        </VBox>

    </left>


    <!-- ========================================================== -->
    <!-- ÁREA PRINCIPAL -->
    <!-- ========================================================== -->

    <center>

        <BorderPane>

            <!-- ================================================== -->
            <!-- HEADER -->
            <!-- ================================================== -->

            <top>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10"
                        styleClass="topbar">

                    <padding>
                        <Insets
                                top="18"
                                right="25"
                                bottom="18"
                                left="25"/>
                    </padding>

                    <children>

                        <!-- ========================================== -->
                        <!-- TÍTULO -->
                        <!-- ========================================== -->

                        <VBox spacing="2">

                            <Label
                                    fx:id="chatTitle"
                                    text="Nexa AI"
                                    styleClass="chat-title"/>


                            <!-- ====================================== -->
                            <!-- STATUS -->
                            <!-- ====================================== -->

                            <HBox
                                    alignment="CENTER_LEFT"
                                    spacing="6">

                                <children>

                                    <Label
                                            text="●"
                                            styleClass="online-dot"/>

                                    <Label
                                            text="Online"
                                            styleClass="online-text"/>

                                </children>

                            </HBox>

                        </VBox>


                        <!-- ========================================== -->
                        <!-- ESPAÇO -->
                        <!-- ========================================== -->

                        <Pane
                                HBox.hgrow="ALWAYS"/>


                        <!-- ========================================== -->
                        <!-- BOTÃO DE TEMA -->
                        <!-- ========================================== -->

                        <Button
                                fx:id="temaButton"
                                text="☀"
                                onAction="#alternarTema"
                                styleClass="theme-button"
                                mnemonicParsing="false"/>

                    </children>

                </HBox>

            </top>


            <!-- ================================================== -->
            <!-- ÁREA DAS MENSAGENS -->
            <!-- ================================================== -->

            <center>

                <ScrollPane
                        fx:id="scrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="chat-scroll">

                    <content>

                        <VBox
                                fx:id="mensagensContainer"
                                spacing="18"
                                fillWidth="true"
                                styleClass="messages-container">

                            <padding>
                                <Insets
                                        top="30"
                                        right="40"
                                        bottom="30"
                                        left="40"/>
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

            </center>


            <!-- ================================================== -->
            <!-- CAMPO DE MENSAGEM -->
            <!-- ================================================== -->

            <bottom>

                <VBox
                        spacing="8"
                        styleClass="input-area">

                    <padding>
                        <Insets
                                top="15"
                                right="30"
                                bottom="20"
                                left="30"/>
                    </padding>

                    <children>

                        <!-- ========================================== -->
                        <!-- CAMPO + BOTÃO -->
                        <!-- ========================================== -->

                        <HBox
                                spacing="10"
                                alignment="CENTER">

                            <TextField
                                    fx:id="mensagemField"
                                    promptText="Digite sua mensagem..."
                                    HBox.hgrow="ALWAYS"
                                    styleClass="message-field"/>


                            <Button
                                    fx:id="enviarButton"
                                    text="➤"
                                    onAction="#enviarMensagem"
                                    styleClass="send-button"
                                    mnemonicParsing="false"/>

                        </HBox>


                        <!-- ========================================== -->
                        <!-- AVISO -->
                        <!-- ========================================== -->

                        <Label
                                text="Nexa AI pode cometer erros. Verifique informações importantes."
                                styleClass="disclaimer"/>

                    </children>

                </VBox>

            </bottom>

        </BorderPane>

    </center>

</BorderPane>